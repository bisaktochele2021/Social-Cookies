<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#1C1C1E"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header with Icon and Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/glass_background_circle"
                android:backgroundTint="#1A1877F2">

                <ImageView
                    android:id="@+id/iv_update_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_system_update"
                    app:tint="#42A5F5" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_update_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Update Available!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/glass_background_pill"
                    android:backgroundTint="#264CAF50"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp">

                    <TextView
                        android:id="@+id/tv_version_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.2"
                        android:textColor="#81C784"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- Changelog Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What's New:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <!-- Release Notes Scroll Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="180dp"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_release_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                tools:text="• Added automated Facebook live/dead checker\n• Added Firebase dynamic notices\n• Bug fixes and speed improvements" />
        </ScrollView>

        <!-- Force update warning notice if mandatory -->
        <TextView
            android:id="@+id/tv_force_update_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_background_pill"
            android:backgroundTint="#26F44336"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="This update is mandatory to continue using the app."
            android:textColor="#EF9A9A"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_now"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Update Now"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                android:backgroundTint="#1877F2"
                app:icon="@drawable/ic_file_download"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_later"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Later"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
